# =====================================================================
# MRP Pipeline Environment Configuration (.env)
# Sao chép file này thành .env và điền các API keys thực tế của bạn
# =====================================================================

# --- CHẾ ĐỘ HOẠT ĐỘNG (NODE_ENV) ---
# development (hiển thị thông tin gỡ lỗi, tốn token) hoặc production (tối giản hiển thị)
NODE_ENV=development


# --- CẤU HÌNH ANTHROPIC CUSTOM GATEWAY (Được ưu tiên) ---
# ANTHROPIC_BASE_URL=http://localhost:20128/v1
# ANTHROPIC_AUTH_TOKEN=sk-53ca8d9a7086f7c2-xlxd1t-14e9bbc7
# ANTHROPIC_MODEL=KhaBoDo_1.0
# # Phương thức kết nối: "sdk" (dùng Anthropic SDK chính thức) hoặc "rest" (dùng Axios REST API thủ công)
# ANTHROPIC_CONNECTION_MODE=sdk

# --- CẤU HÌNH GOOGLE GEMINI API (Nếu muốn dùng Gemini) ---
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-pro

# --- CẤU HÌNH OPENAI API (Nếu muốn dùng GPT-4) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# =====================================================================
# Provider: 9Router (OpenAI-compatible)
# =====================================================================
# OPENAI_API_KEY=sk-53ca8d9a7086f7c2-xlxd1t-14e9bbc7
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_MODEL=9router/KhaBoDo_1.0
